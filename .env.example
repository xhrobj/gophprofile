# PostgreSQL
POSTGRES_DB=gophprofile
POSTGRES_USER=gophprofile
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432

# S3 / MinIO
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=avatars
S3_USE_SSL=false

# RabbitMQ
RABBITMQ_USER=gophprofile
RABBITMQ_PASSWORD=password
RABBITMQ_URL=amqp://gophprofile:password@localhost:5672/
RABBITMQ_EXCHANGE=avatars.exchange
RABBITMQ_QUEUE=avatars.processing

# OpenTelemetry tracing
TRACING_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Server
HTTP_ADDRESS=:8080
MAX_UPLOAD_SIZE=10485760

# Worker
WORKER_METRICS_ADDRESS=:9092

# Graceful shutdown
SHUTDOWN_TIMEOUT=10s

# Logging
LOG_LEVEL=info
