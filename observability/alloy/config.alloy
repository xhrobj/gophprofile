discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"

  // Ограничиваем discovery контейнерами приложения GophProfile.
  filter {
    name   = "label"
    values = ["gophprofile.logs=true"]
  }
}

discovery.relabel "application_logs" {
  targets = discovery.docker.containers.targets

  // Используем имя Compose-сервиса как стабильный low-cardinality label.
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "application" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.application_logs.output
  labels     = {}
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
